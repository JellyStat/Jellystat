# Copy this file to .env and fill in the values.
# Every setting is described in docs/configuration.md.

# --- Database (required) ---
DB_USERNAME=jellystat
DB_PASSWORD=change-me
DB_NAME=jellystat

# --- Security (required) ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_KEY=

# --- Timezone ---
TZ=Etc/UTC

# --- Optional ---
# JS_GEOLITE_ACCOUNT_ID=
# JS_GEOLITE_LICENSE_KEY=
# MINIMUM_SECONDS_TO_INCLUDE_PLAYBACK=1
# NEW_WATCH_EVENT_THRESHOLD_HOURS=1
# COMPLETION_THRESHOLD_PERCENTAGE=90
# REPORTS_MAX_ROWS=10000
